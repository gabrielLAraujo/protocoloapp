        "required": [
          "added",
          "removed",
          "changed"
        ],
        "type": "object",
        "properties": {
          "added": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "removed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanChange"
            }
          }
        }
      },
