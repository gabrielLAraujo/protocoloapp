        "enum": [
          "protocol",
          "workout"
        ]
      },
      "PlanStatus": {
        "enum": [
          "draft",
          "active",
          "archived"
        ]
      },
      "PlanVersionResponse": {
        "required": [
          "id",
          "kind",
          "status",
          "document",
          "lowConfidence",
          "extractionError",
          "newExercises",
          "diff",
          "activatedAt",
          "sourceFileId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/PlanKind"
          },
          "status": {
            "$ref": "#/components/schemas/PlanStatus"
          },
          "document": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "lowConfidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extractionError": {
            "type": [
              "null",
              "string"
            ]
          },
          "newExercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NewExerciseSuggestion"
            }
          },
          "diff": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PlanDiffDto"
              }
            ]
          },
          "activatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "sourceFileId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PlanVersionSummary": {
        "required": [
          "id",
          "kind",
          "status",
          "createdAt",
          "activatedAt",
          "sourceFileId",
          "extractionError"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/PlanKind"
          },
          "status": {
            "$ref": "#/components/schemas/PlanStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "activatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "sourceFileId": {
            "type": "string",
            "format": "uuid"
          },
          "extractionError": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
