        "enum": [
          "chest",
          "back",
          "shoulders",
          "biceps",
          "triceps",
          "quads",
          "hamstrings",
          "glutes",
          "calves",
          "abs",
          "forearms",
          "lowerBack",
          "mobility",
          "other"
        ]
      },
